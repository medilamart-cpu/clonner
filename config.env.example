# Telegram API Credentials (from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Phone number with country code (e.g., +1234567890)
PHONE_NUMBER=+1234567890

# Source Group/Forum (can be username @groupname, invite link https://t.me/..., or ID -100...)
SOURCE_CHAT=@source_forum_username

# Destination Group/Forum (where content will be cloned)
DEST_CHAT=@dest_forum_username

# Mode settings:
# CLONE_HISTORY: Set to True to clone all past messages, False to skip history
CLONE_HISTORY=True

# LIVE_FORWARD: Set to True to keep running and copy new messages in real-time
LIVE_FORWARD=True

# FORWARD_MODE: 
# "copy"    - (Recommended) Sends fresh clean messages without "Forwarded from" tag.
#             Works even if the source group has restricted saving / no-forwards.
# "forward" - Uses official Telegram forwarding with forward header.
FORWARD_MODE=copy

# Delay in seconds between copying messages (prevents Telegram rate limit FloodWait)
DELAY_BETWEEN_MESSAGES=1.2

# Directory for temporary media downloads
TEMP_DIR=temp_downloads
